---

import MainGridLayout from "../layouts/MainGridLayout.astro";

import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";

const lanpaintPage = await getEntry("spec", "lanpaint");

if (!lanpaintPage) {
	throw new Error("LanPaint page content not found");
}

const { Content, headings } = await render(lanpaintPage);
---
<MainGridLayout
	title="LanPaint — Training-Free Conditional Sampling for Inpainting and Local Image Editing"
	description="LanPaint is a training-free partial conditional sampler for mask-constrained inpainting and local editing with pretrained diffusion and rectified-flow models, without fine-tuning or backpropagation."
	headings={headings}
>
	<article class="lanpaint-page flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
		<div class="lanpaint-card card-base z-10 relative w-full">
			<Markdown class="lanpaint-content">
				<Content />
			</Markdown>
		</div>
	</article>
</MainGridLayout>

<style is:global>
	.lanpaint-page {
		--lanpaint-content-width: 48rem;
		--lanpaint-rule: color-mix(in oklab, var(--line-divider) 72%, transparent);
	}

	.lanpaint-card {
		background:
			linear-gradient(180deg, color-mix(in oklab, var(--card-bg) 96%, var(--primary) 4%), var(--card-bg));
	}

	.lanpaint-content {
		width: min(100%, var(--lanpaint-content-width));
		margin-inline: auto;
		padding: clamp(2rem, 4vw, 4.75rem) clamp(1.25rem, 5vw, 5.5rem) 4.5rem;
		font-size: 1.02rem;
		line-height: 1.85;
		letter-spacing: 0.002em;
	}

	.lanpaint-content > section:first-child > h1 {
		margin: 0;
		color: var(--tw-prose-headings);
		font-size: clamp(2.35rem, 5vw, 4rem);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 1.05;
	}

	.lanpaint-content > section:first-child > section:first-of-type > h2 {
		margin: 1rem 0 1.8rem;
		padding-bottom: 1.8rem;
		border-bottom: 1px solid var(--lanpaint-rule);
		color: color-mix(in oklab, var(--tw-prose-headings) 72%, var(--tw-prose-body));
		font-size: clamp(1.2rem, 2.2vw, 1.55rem);
		font-weight: 500;
		letter-spacing: -0.015em;
		line-height: 1.35;
	}

	.lanpaint-content > section:first-child > section:first-of-type > p:first-of-type {
		margin: 0 0 2rem;
		color: color-mix(in oklab, var(--tw-prose-body) 88%, var(--tw-prose-headings));
		font-size: 1.1rem;
		line-height: 1.75;
	}

	.lanpaint-content h2 {
		margin-top: 4.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--lanpaint-rule);
		color: var(--tw-prose-headings);
		font-size: clamp(1.45rem, 2.8vw, 1.9rem);
		font-weight: 750;
		letter-spacing: -0.025em;
		line-height: 1.25;
	}

	.lanpaint-content > section:first-child > section:first-of-type > h2 {
		border-top: 0;
		padding-top: 0;
	}

	.lanpaint-content h3 {
		margin-top: 2.8rem;
		color: var(--tw-prose-headings);
		font-size: 1.12rem;
		font-weight: 700;
		letter-spacing: 0.005em;
		line-height: 1.4;
	}

	.lanpaint-content p {
		margin-top: 1.2rem;
		margin-bottom: 1.2rem;
	}

	.lanpaint-content ul,
	.lanpaint-content ol {
		margin-top: 1.4rem;
		margin-bottom: 1.7rem;
		padding-left: 1.4rem;
	}

	.lanpaint-content li {
		margin-top: 0.55rem;
		padding-left: 0.25rem;
	}

	.lanpaint-content li::marker {
		color: var(--primary);
		font-weight: 700;
	}

	.lanpaint-content strong {
		color: var(--tw-prose-headings);
		font-weight: 700;
	}

	.lanpaint-content a:not(.lanpaint-resource) {
		font-weight: 500;
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
	}

	.lanpaint-content hr {
		display: none;
	}

	.lanpaint-content blockquote {
		margin-block: 2rem;
		padding: 0.9rem 1.25rem;
		border-left: 3px solid var(--primary);
		background: color-mix(in oklab, var(--primary) 5%, transparent);
		font-size: 1.02rem;
	}

	.lanpaint-content pre {
		margin-block: 2rem;
	}

	.lanpaint-content .lanpaint-resource-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.7rem;
		margin: 2rem 0 2.75rem;
	}

	.lanpaint-content .lanpaint-resource {
		display: flex;
		min-height: 6.5rem;
		flex-direction: column;
		justify-content: space-between;
		gap: 0.6rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--lanpaint-rule);
		border-radius: 0.85rem;
		background: color-mix(in oklab, var(--card-bg) 70%, var(--primary) 3%);
		color: var(--tw-prose-body);
		text-decoration: none;
		transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease;
	}

	.lanpaint-content .lanpaint-resource:hover {
		border-color: color-mix(in oklab, var(--primary) 58%, var(--lanpaint-rule));
		background: color-mix(in oklab, var(--primary) 8%, var(--card-bg));
		transform: translateY(-2px);
	}

	.lanpaint-content .lanpaint-resource-label {
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		line-height: 1;
		text-transform: uppercase;
	}

	.lanpaint-content .lanpaint-resource-name {
		color: var(--tw-prose-headings);
		font-size: 0.98rem;
		font-weight: 650;
		line-height: 1.35;
	}

	@media (max-width: 767px) {
		.lanpaint-content {
			padding: 2.25rem 1.25rem 3.5rem;
			font-size: 1rem;
			line-height: 1.78;
		}

		.lanpaint-content h2 {
			margin-top: 3.5rem;
			padding-top: 1.5rem;
		}

		.lanpaint-content h3 {
			margin-top: 2.2rem;
		}

		.lanpaint-content .lanpaint-resource-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
